# Copy to devenv.local.nix (gitignored; devenv imports it by itself) for
# settings of this machine only. They steer `rpi-deploy` and never reach the
# Pi's system or the cache, so they are not in a host module.
{ ... }:
{
  env = {
    # The host rpi-deploy works on when the flake has several (default: the
    # only Pi host; several and none set -> exit 2 listing them).
    RPI_HOST = "rpi";

    # Override the host's rpi.deploy.target (default root@<hostname>) and
    # rpi.ssh.port, e.g. while the hostname does not resolve yet. Only for
    # the default host: without `--host` or with `--host $RPI_HOST`; any
    # other `--host` (any `--host` while RPI_HOST is unset, even the only
    # host) ignores them (use --target/--port there).
    # RPI_TARGET = "root@192.168.1.20";
    # RPI_PORT = "22";
  };

  # Your own Cachix cache, once it exists (the README setup steps): local
  # aarch64 builds (rpi-deploy image, the qemu smokes) then fetch the closure
  # instead of compiling it under binfmt. The module system appends this to
  # the list in devenv.nix (the nvmd kernel cache); a cache that does not
  # exist yet breaks `devenv shell` setup. To drop an entry instead, use
  # lib.mkForce with the whole list. The shell only pulls; CI publishes
  # (no cachix.watch).
  # cachix.pull = [ "<your-cache>" ];
}
